# vitepress-plugin-mermaid adds mermaid's transitive deps to Vite's
# optimizeDeps.include. Under pnpm's strict node_modules they aren't linked at
# the project root, so Vite can't pre-bundle them (dayjs, a UMD module, then
# fails with "does not provide an export named 'default'"). Hoist them so Vite
# can resolve and pre-bundle them.
public-hoist-pattern[]=dayjs
public-hoist-pattern[]=debug
public-hoist-pattern[]=@braintree/sanitize-url
public-hoist-pattern[]=cytoscape
public-hoist-pattern[]=cytoscape-cose-bilkent
